__HOST__ {
	encode gzip
	header {
		X-Content-Type-Options nosniff
		X-Robots-Tag "noindex, nofollow"
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'self'; img-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
	}
	# screenshots: up to 6 pictures of 5 MB (the app checks each one too)
	@upload path /api/screenshots
	handle @upload {
		request_body {
			max_size 32MB
		}
		reverse_proxy 127.0.0.1:8000
	}
	handle {
		request_body {
			max_size 64KB
		}
		reverse_proxy 127.0.0.1:8000
	}
}
