# ── Large model binaries (the 11 GB FastText vectors) ──────────────────
# Not needed for web-inspection v1; must never be pushed.
pretrained/
*.bin

# Trained models (~176 MB); regenerate with python -m src.features.model.rf_extractor
models/*
# Except the word embeddings (26 MB): rebuilding them needs the 19 GB fastText download,
# so they are committed and everyone trains on identical vectors.
!models/embeddings/

# ── Data and VM artifacts (never belong in git) ────────────────────────
/data/
*.vdi
*.vmdk
*.vhd
*.ova
*.iso
*.jsonl
*.jsonl.gz
*.sqlite
*.db
*.pcap
*.parquet

# ── Secrets ────────────────────────────────────────────────────────────
*.key
*.pem
wg0.conf
.env
.env.*
known_hosts_lejet

# ── Python ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

